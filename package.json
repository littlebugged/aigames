{
  "name": "neon-surge",
  "private": true,
  "version": "1.11.0",
  "description": "霓虹浪涌 NEON SURGE — 纯前端的霓虹生存肉鸽游戏",
  "type": "module",
  "scripts": {
    "gen": "tsx scripts/gen-pages.ts",
    "dev": "npm run gen && vite",
    "build": "npm run gen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "tsx --test tests/*.test.ts",
    "sim": "tsx scripts/sim.ts",
    "bench": "tsx scripts/bench-weapons.ts",
    "e2e": "node scripts/e2e.mjs",
    "icons": "node --import tsx scripts/icon-sheet.mjs"
  },
  "devDependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@types/node": "^22.10.0",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  }
}
