{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["scripts", "tests", "vite.config.ts", "src/data", "src/game", "src/engine/rng.ts", "src/engine/math.ts", "src/engine/grid.ts", "src/engine/pool.ts", "src/i18n"]
}
